/// Rate scenario chosen on the overview page.
table Scenario
	lineageTag: f07e9807-fbb6-5679-b7b4-2d2b2371c48a

	column Scenario
		dataType: string
		lineageTag: f91cc2be-a801-53eb-b4fb-4dc642ed07e0
		summarizeBy: none
		sourceColumn: Scenario
		sortByColumn: Order

		annotation SummarizationSetBy = User

	column 'Shift bps'
		dataType: int64
		lineageTag: f7d01379-e542-58f2-abb3-63d90f769e8a
		summarizeBy: none
		sourceColumn: Shift bps

		annotation SummarizationSetBy = User

	column Order
		dataType: int64
		isHidden
		lineageTag: cfcb4b67-b007-59f9-8069-dbccdcf0948b
		summarizeBy: none
		sourceColumn: Order

		annotation SummarizationSetBy = User

	partition Scenario = m
		mode: import
		source =
				let
				    Source = #table(type table [Scenario = text, #"Shift bps" = Int64.Type, Order = Int64.Type], {{"-50 bps", -50, 1}, {"Base", 0, 2}, {"+50 bps", 50, 3}})
				in
				    Source

	annotation PBI_ResultType = Table
