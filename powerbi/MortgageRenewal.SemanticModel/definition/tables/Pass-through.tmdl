	partition 'Pass-through' = m
		mode: import
		source =
				let
				    IsWeb = Text.StartsWith(DataFolder, "http"),
				    Folder = Text.TrimEnd(DataFolder, {"\", "/"}) & (if IsWeb then "/" else "\"),
				    Raw = if IsWeb then Web.Contents(Folder & "fact_regression_coef.csv") else File.Contents(Folder & "fact_regression_coef.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"term", "lag_months", "coef", "std_err_hac", "t_stat", "p_value", "ci95_low", "ci95_high", "cumulative_pass_through"}),
				    Blanks = Table.ReplaceValue(Kept, "", null, Replacer.ReplaceValue, Table.ColumnNames(Kept)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"term", type text}, {"lag_months", Int64.Type}, {"coef", type number}, {"std_err_hac", type number}, {"t_stat", type number}, {"p_value", type number}, {"ci95_low", type number}, {"ci95_high", type number}, {"cumulative_pass_through", type number}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"term", "Term"}, {"lag_months", "Lag months"}, {"coef", "Coefficient"}, {"std_err_hac", "Std error"}, {"t_stat", "t stat"}, {"p_value", "p-value"}, {"ci95_low", "CI low"}, {"ci95_high", "CI high"}, {"cumulative_pass_through", "Cumulative"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
