	partition 'Call Capacity' = m
		mode: import
		source =
				let
				    IsWeb = Text.StartsWith(DataFolder, "http"),
				    Folder = Text.TrimEnd(DataFolder, {"\", "/"}) & (if IsWeb then "/" else "\"),
				    Raw = if IsWeb then Web.Contents(Folder & "fact_triage_capacity.csv") else File.Contents(Folder & "fact_triage_capacity.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"capacity_per_week", "n_contacted", "n_over_threshold", "over_contacted", "over_missed", "over_too_soon_to_reach", "segment1_missed", "segment2_missed", "missed_rise_per_month", "over_missed_if_by_date_only", "segment1_missed_if_by_date_only", "missed_rise_per_month_if_by_date_only", "single_scenario_list_changes_if_rates_fall", "single_scenario_list_changes_if_rates_rise"}),
				    Blanks = Table.ReplaceValue(Kept, "", null, Replacer.ReplaceValue, Table.ColumnNames(Kept)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"capacity_per_week", Int64.Type}, {"n_contacted", Int64.Type}, {"n_over_threshold", Int64.Type}, {"over_contacted", Int64.Type}, {"over_missed", Int64.Type}, {"over_too_soon_to_reach", Int64.Type}, {"segment1_missed", Int64.Type}, {"segment2_missed", Int64.Type}, {"missed_rise_per_month", type number}, {"over_missed_if_by_date_only", Int64.Type}, {"segment1_missed_if_by_date_only", Int64.Type}, {"missed_rise_per_month_if_by_date_only", type number}, {"single_scenario_list_changes_if_rates_fall", Int64.Type}, {"single_scenario_list_changes_if_rates_rise", Int64.Type}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"capacity_per_week", "Calls per week"}, {"n_contacted", "Contacted"}, {"n_over_threshold", "Over threshold"}, {"over_contacted", "Over contacted"}, {"over_missed", "Over missed"}, {"over_too_soon_to_reach", "Too soon to reach"}, {"segment1_missed", "Segment 1 missed"}, {"segment2_missed", "Segment 2 missed"}, {"missed_rise_per_month", "Missed rise per month"}, {"over_missed_if_by_date_only", "Over missed, date order"}, {"segment1_missed_if_by_date_only", "Segment 1 missed, date order"}, {"missed_rise_per_month_if_by_date_only", "Missed rise per month, date order"}, {"single_scenario_list_changes_if_rates_fall", "List changes if rates fall"}, {"single_scenario_list_changes_if_rates_rise", "List changes if rates rise"}}),
				    Labelled = Table.AddColumn(Renamed, "Capacity", each Text.From([Calls per week]) & " calls a week", type text)
				in
				    Labelled

	annotation PBI_ResultType = Table
