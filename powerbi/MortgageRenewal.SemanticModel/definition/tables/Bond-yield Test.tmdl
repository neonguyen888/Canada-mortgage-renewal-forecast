	partition 'Bond-yield Test' = m
		mode: import
		source =
				let
				    IsWeb = Text.StartsWith(DataFolder, "http"),
				    Folder = Text.TrimEnd(DataFolder, {"\", "/"}) & (if IsWeb then "/" else "\"),
				    Raw = if IsWeb then Web.Contents(Folder & "fact_regression_dm.csv") else File.Contents(Folder & "fact_regression_dm.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"comparison", "horizon_months", "n_origins", "mean_abs_error_diff_bps", "dm_stat_hln", "p_value", "significant_at_5pct"}),
				    Blanks = Table.ReplaceValue(Kept, "", null, Replacer.ReplaceValue, Table.ColumnNames(Kept)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"comparison", type text}, {"horizon_months", Int64.Type}, {"n_origins", Int64.Type}, {"mean_abs_error_diff_bps", type number}, {"dm_stat_hln", type number}, {"p_value", type number}, {"significant_at_5pct", type logical}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"comparison", "Comparison"}, {"horizon_months", "Horizon"}, {"n_origins", "Origins"}, {"mean_abs_error_diff_bps", "Mean difference bps"}, {"dm_stat_hln", "DM statistic"}, {"p_value", "p-value"}, {"significant_at_5pct", "Significant"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
