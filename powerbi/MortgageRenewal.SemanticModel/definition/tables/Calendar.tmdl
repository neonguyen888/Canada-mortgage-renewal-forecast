/// One row per month, from the first observation to the last forecast month.
table Calendar
	lineageTag: 6dfb7d66-69eb-5791-97ac-a4ef44f879a8

	column Month
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 612fea14-93ca-56fd-b1ee-21198352319d
		summarizeBy: none
		sourceColumn: Month

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = User

	column Year
		dataType: int64
		lineageTag: d94bb028-8493-5000-9a32-fbdbeec5d18b
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = User

	column 'Month number'
		dataType: int64
		isHidden
		lineageTag: ff387f5c-322c-5519-ae44-4118b2953bce
		summarizeBy: none
		sourceColumn: Month number

		annotation SummarizationSetBy = User

	column 'Month label'
		dataType: string
		lineageTag: e7b1599f-6ca9-52cd-b326-778f5829f9f8
		summarizeBy: none
		sourceColumn: Month label
		sortByColumn: Month

		annotation SummarizationSetBy = User

	partition Calendar = m
		mode: import
		source =
				let
				    IsWeb = Text.StartsWith(DataFolder, "http"),
				    Folder = Text.TrimEnd(DataFolder, {"\", "/"}) & (if IsWeb then "/" else "\"),
				    Raw = if IsWeb then Web.Contents(Folder & "dim_month.csv") else File.Contents(Folder & "dim_month.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"month", "year", "month_num", "month_label"}),
				    Blanks = Table.ReplaceValue(Kept, "", null, Replacer.ReplaceValue, Table.ColumnNames(Kept)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"month", type date}, {"year", Int64.Type}, {"month_num", Int64.Type}, {"month_label", type text}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"month", "Month"}, {"year", "Year"}, {"month_num", "Month number"}, {"month_label", "Month label"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
