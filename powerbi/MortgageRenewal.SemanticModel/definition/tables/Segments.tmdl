/// The four triage segments with their size and typical payment rise.
table Segments
	lineageTag: d01344d1-d48f-55dd-b3a1-49700bcf35ef

	column 'Segment order'
		dataType: int64
		isHidden
		lineageTag: 28f02531-8879-5bdc-aee4-2d51739d15b4
		summarizeBy: none
		sourceColumn: Segment order

		annotation SummarizationSetBy = User

	column Segment
		dataType: string
		lineageTag: 2ff46394-635b-5ef5-a129-2262055ecdc4
		summarizeBy: none
		sourceColumn: Segment
		sortByColumn: 'Segment order'

		annotation SummarizationSetBy = User

	column Loans
		dataType: int64
		formatString: #,0
		lineageTag: 49e0bbaf-1b79-5bbc-88b7-129ab1938b49
		summarizeBy: none
		sourceColumn: Loans

		annotation SummarizationSetBy = User

	column 'Median rise'
		dataType: double
		formatString: \$#,0
		lineageTag: 266e0eda-cd27-595d-8931-65c825a031ac
		summarizeBy: none
		sourceColumn: Median rise

		annotation SummarizationSetBy = User

	column 'Lowest rise if rates fall'
		dataType: double
		formatString: \$#,0
		lineageTag: 2ac76930-52f0-5a86-8261-4a074a7dd70a
		summarizeBy: none
		sourceColumn: Lowest rise if rates fall

		annotation SummarizationSetBy = User

	column 'Called at 300 a week'
		dataType: int64
		formatString: #,0
		lineageTag: 9e0111ab-ca66-569a-ae65-688157625329
		summarizeBy: none
		sourceColumn: Called at 300 a week

		annotation SummarizationSetBy = User

	column 'Share called at 300'
		dataType: double
		formatString: 0.0
		lineageTag: 24576937-d900-5c42-943c-90703be8ff0e
		summarizeBy: none
		sourceColumn: Share called at 300

		annotation SummarizationSetBy = User

	partition Segments = m
		mode: import
		source =
				let
				    IsWeb = Text.StartsWith(DataFolder, "http"),
				    Folder = Text.TrimEnd(DataFolder, {"\", "/"}) & (if IsWeb then "/" else "\"),
				    Raw = if IsWeb then Web.Contents(Folder & "vw_triage_segment.csv") else File.Contents(Folder & "vw_triage_segment.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"segment_order", "segment", "n_loans", "median_rise_at_forecast", "lowest_rise_if_rates_fall", "n_contacted_at_300", "pct_contacted_at_300"}),
				    Blanks = Table.ReplaceValue(Kept, "", null, Replacer.ReplaceValue, Table.ColumnNames(Kept)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"segment_order", Int64.Type}, {"segment", type text}, {"n_loans", Int64.Type}, {"median_rise_at_forecast", type number}, {"lowest_rise_if_rates_fall", type number}, {"n_contacted_at_300", Int64.Type}, {"pct_contacted_at_300", type number}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"segment_order", "Segment order"}, {"segment", "Segment"}, {"n_loans", "Loans"}, {"median_rise_at_forecast", "Median rise"}, {"lowest_rise_if_rates_fall", "Lowest rise if rates fall"}, {"n_contacted_at_300", "Called at 300 a week"}, {"pct_contacted_at_300", "Share called at 300"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
