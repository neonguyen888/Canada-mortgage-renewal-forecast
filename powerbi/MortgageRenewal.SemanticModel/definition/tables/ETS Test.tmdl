/// Diebold-Mariano test of ETS against the naive model.
table 'ETS Test'
	lineageTag: 779c44c8-b298-5331-a869-f758962f4f61

	column Horizon
		dataType: int64
		isHidden
		lineageTag: ae2b70ff-0081-5adc-b9a8-c42c98c90310
		summarizeBy: none
		sourceColumn: Horizon

		annotation SummarizationSetBy = User

	column Origins
		dataType: int64
		isHidden
		lineageTag: 6c5fe32a-ddf7-5976-8784-8e48bac56af4
		summarizeBy: none
		sourceColumn: Origins

		annotation SummarizationSetBy = User

	column 'Mean difference bps'
		dataType: double
		isHidden
		formatString: 0.00
		lineageTag: d9187a9b-2d16-5907-af10-bea5127aacb1
		summarizeBy: none
		sourceColumn: Mean difference bps

		annotation SummarizationSetBy = User

	column 'DM statistic'
		dataType: double
		isHidden
		formatString: 0.000
		lineageTag: 2be225c8-ca12-5735-b08f-9edfd25f67c4
		summarizeBy: none
		sourceColumn: DM statistic

