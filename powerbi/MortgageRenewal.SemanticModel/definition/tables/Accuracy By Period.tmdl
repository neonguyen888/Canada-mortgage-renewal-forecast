	partition 'Accuracy By Period' = m
		mode: import
		source =
				let
				    IsWeb = Text.StartsWith(DataFolder, "http"),
				    Folder = Text.TrimEnd(DataFolder, {"\", "/"}) & (if IsWeb then "/" else "\"),
				    Raw = if IsWeb then Web.Contents(Folder & "vw_backtest_by_period.csv") else File.Contents(Folder & "vw_backtest_by_period.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"period_order", "period_name", "model", "horizon_months", "mae_bps", "mae_cad_per_month", "bias_bps", "n_forecasts"}),
				    Blanks = Table.ReplaceValue(Kept, "", null, Replacer.ReplaceValue, Table.ColumnNames(Kept)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"period_order", Int64.Type}, {"period_name", type text}, {"model", type text}, {"horizon_months", Int64.Type}, {"mae_bps", type number}, {"mae_cad_per_month", type number}, {"bias_bps", type number}, {"n_forecasts", Int64.Type}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"period_order", "Period order"}, {"period_name", "Period"}, {"model", "Model"}, {"horizon_months", "Horizon"}, {"mae_bps", "MAE bps"}, {"mae_cad_per_month", "MAE CAD"}, {"bias_bps", "Bias bps"}, {"n_forecasts", "Forecasts"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
