/// Every rate from 0.00% to 10.00% in 0.01 steps, for the payment curve and threshold search.
table 'Rate Grid'
	lineageTag: 142e0c59-2cd4-581d-9ed7-e5b525c596a5

	column Rate
		dataType: double
		formatString: 0.00\%
		lineageTag: ab872cba-8181-580a-a8af-1ff9de7411b1
		summarizeBy: none
		sourceColumn: Rate

		annotation SummarizationSetBy = User

	partition 'Rate Grid' = m
		mode: import
		source =
				let
				    IsWeb = Text.StartsWith(DataFolder, "http"),
				    Folder = Text.TrimEnd(DataFolder, {"\", "/"}) & (if IsWeb then "/" else "\"),
				    Raw = if IsWeb then Web.Contents(Folder & "vw_rate_grid.csv") else File.Contents(Folder & "vw_rate_grid.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"rate_pct"}),
				    Blanks = Table.ReplaceValue(Kept, "", null, Replacer.ReplaceValue, Table.ColumnNames(Kept)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"rate_pct", type number}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"rate_pct", "Rate"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
