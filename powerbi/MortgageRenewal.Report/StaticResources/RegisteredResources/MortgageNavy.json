{
  "name": "Mortgage Navy",
  "dataColors": [
    "#7FB2F0",
    "#4FD1B5",
    "#F2B05E",
    "#B49CF5",
    "#3B4B63",
    "#F27E6B",
    "#5E8BC7",
    "#8FD9C4"
  ],
  "foreground": "#E9EEF5",
  "foregroundNeutralSecondary": "#A3B0C2",
  "foregroundNeutralTertiary": "#6D7C91",
  "background": "#0F1B2D",
  "backgroundLight": "#16243B",
  "backgroundNeutral": "#1C2A40",
  "tableAccent": "#4FD1B5",
  "good": "#4FD1B5",
  "neutral": "#F2B05E",
  "bad": "#F27E6B",
  "maximum": "#F2B05E",
  "center": "#3B4B63",
  "minimum": "#0F1B2D",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Light",
      "color": "#E9EEF5"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E9EEF5"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E9EEF5"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#A3B0C2"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#E9EEF5"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#6D7C91"
              }
            },
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#6D7C91"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#1A2639"
              }
            },
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#A3B0C2"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#0F1B2D"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#E9EEF5"
              }
            },
            "transparency": 0,
            "borderColor": {
              "solid": {
                "color": "#1C2A40"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#16243B"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#E9EEF5"
              }
            },
            "transparency": 0
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#0F1B2D"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#E9EEF5"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0A1322"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0A1322"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#E9EEF5"
              }
            },
            "fontSize": 26,
            "fontFamily": "Segoe UI Light"
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#E9EEF5"
              }
            },
            "background": {
              "solid": {
                "color": "#0F1B2D"
              }
            }
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#A3B0C2"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#A3B0C2"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0F1B2D"
              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#E9EEF5"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#0F1B2D"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E9EEF5"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#0F1B2D"
              }
            }
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontalColor": {
              "solid": {
                "color": "#1C2A40"
              }
            }
          }
        ]
      }
    }
  }
}
